#!/usr/bin/python3
"""Build one self-contained Intel and Apple Silicon sharing archive."""
import hashlib
import atexit
import json
import os
import plistlib
from pathlib import Path
import shutil
import subprocess
import tempfile
import urllib.request

ROOT = Path(__file__).resolve().parent
BUILD = Path.home()/'Library/Caches/LiSTdBuild'
UPSTREAM = BUILD/'upstream'
ARCHITECTURES = ('arm64', 'x86_64')
FFMPEG_FLAGS = [
    '--arch=arm64', '--cc=/usr/bin/clang', '--extra-cflags=-mmacosx-version-min=14.0',
    '--extra-ldflags=-mmacosx-version-min=14.0', '--disable-autodetect', '--disable-network',
    '--disable-doc', '--disable-debug', '--disable-avdevice', '--disable-swscale',
    '--disable-videotoolbox', '--disable-audiotoolbox', '--disable-everything',
    '--enable-ffmpeg', '--enable-ffprobe', '--enable-protocol=file,pipe',
    '--enable-demuxer=mp3,flac,wav,aiff,mov,aac,ogg,wv',
    '--enable-decoder=mp3,mp3float,flac,alac,aac,aac_fixed,vorbis,opus,wavpack,pcm_s16le,pcm_s16be,pcm_s24le,pcm_s24be,pcm_s32le,pcm_s32be,pcm_f32le,pcm_f32be,pcm_f64le,pcm_f64be,pcm_u8,pcm_s8',
    '--enable-parser=mpegaudio,flac,aac,vorbis,opus', '--enable-encoder=pcm_f32le,pcm_s16le',
    '--enable-muxer=pcm_f32le,pcm_s16le,null,wav', '--enable-filter=aresample,anull,aformat,asetpts', '--enable-small'
]


def run(*args, **kwargs):
    kwargs.setdefault('cwd', ROOT)
    subprocess.run([str(a) for a in args], check=True, **kwargs)


def fetch(url, path, digest=None):
    if not path.exists():
        temporary = path.with_suffix(path.suffix+'.part')
        urllib.request.urlretrieve(url, temporary)
        temporary.replace(path)
    if digest and hashlib.sha256(path.read_bytes()).hexdigest() != digest:
        raise ValueError(f'Checksum failed: {path.name}. Remove it and retry.')


def main():
    os.chdir(ROOT)
    if os.uname().machine != 'arm64':
        raise SystemExit('Build the universal app on Apple Silicon with Rosetta and Apple command-line tools.')
    UPSTREAM.mkdir(parents=True, exist_ok=True)
    run(ROOT/'build-crate')
    archive = UPSTREAM/'ffmpeg-8.0.tar.xz'
    fetch('https://ffmpeg.org/releases/ffmpeg-8.0.tar.xz', archive,
          'b2751fccb6cc4c77708113cd78b561059b6fa904b24162fa0be2d60273d27b8e')
    source = UPSTREAM/'sockseek-3.0.6-source.tar.gz'
    fetch('https://codeload.github.com/fiso64/sockseek/tar.gz/refs/tags/v3.0.6', source)

    release = ROOT/'release'
    release.mkdir(exist_ok=True)
    # Desktop sync can restore FinderInfo while signing; seal outside the synced tree.
    staging = Path(tempfile.mkdtemp(prefix='listd-release-'))
    atexit.register(shutil.rmtree, staging, ignore_errors=True)
    payload = staging/'LiSTd'
    payload.mkdir()
    shutil.copy2(ROOT/'native/Assets/ReadMe.txt', payload/'READ ME FIRST.txt')
    app = payload/'LiSTd.app'
    (app/'Contents/MacOS').mkdir(parents=True)
    shutil.copy2(ROOT/'LiSTd.app/Contents/MacOS/LiSTd', app/'Contents/MacOS/LiSTd')
    shutil.copy2(ROOT/'LiSTd.app/Contents/Info.plist', app/'Contents/Info.plist')
    plist_path = app/'Contents/Info.plist'
    plist = plistlib.loads(plist_path.read_bytes())
    plist['LiSTdStandalone'] = True
    plist_path.write_bytes(plistlib.dumps(plist))
    resources = app/'Contents/Resources'
    resources.mkdir()
    for icon in ('EarIcon.icns', 'Crate.icns', 'CrateSilverwave.icns'):
        shutil.copy2(ROOT/'LiSTd.app/Contents/Resources'/icon, resources/icon)
    backend = resources/'backend'
    for architecture in ARCHITECTURES:
        prefix = ['/usr/bin/arch', '-'+architecture]
        environment = BUILD/('python-'+architecture)
        python = environment/'bin/python'
        if not python.exists():
            run(*prefix, '/usr/bin/python3', '-m', 'venv', environment)
        run(*prefix, python, '-m', 'pip', 'install', '-r', 'requirements-package.txt')
        work = BUILD/('freeze-work' if architecture == 'arm64' else 'freeze-work-x86_64')
        dist = BUILD/('frozen' if architecture == 'arm64' else 'frozen-x86_64')
        run(*prefix, python, '-m', 'PyInstaller', '--noconfirm', '--clean', '--onedir', '--name', 'listd-backend',
            '--copy-metadata', 'librosa', '--copy-metadata', 'numpy',
            '--copy-metadata', 'numba', '--copy-metadata', 'llvmlite',
            '--target-arch', architecture, '--exclude-module', 'torch', '--exclude-module', 'tensorflow',
            '--exclude-module', 'matplotlib', '--exclude-module', 'pandas', '--exclude-module', 'IPython',
            '--exclude-module', 'pytest', '--distpath', dist, '--workpath', work, '--specpath', work, 'crate_backend.py')
        destination = backend/architecture
        shutil.copytree(dist/'listd-backend', destination, symlinks=True)

        # Homebrew's FFmpeg can require a newer macOS and nonportable dylibs.
        ffmpeg = UPSTREAM/('ffmpeg-8.0' if architecture == 'arm64' else 'ffmpeg-8.0-x86_64')
        flags = list(FFMPEG_FLAGS)
        flags[0] = '--arch='+architecture
        if architecture == 'x86_64':
            flags += ['--disable-x86asm', '--extra-cflags=-arch x86_64 -mmacosx-version-min=14.0',
                      '--extra-ldflags=-arch x86_64 -mmacosx-version-min=14.0']
        flags_file = ffmpeg/'.listd-flags.json'
        if (not (ffmpeg/'ffmpeg').exists() or not (ffmpeg/'ffprobe').exists()
                or not flags_file.exists() or json.loads(flags_file.read_text()) != flags):
            ffmpeg.mkdir(exist_ok=True)
            run('/usr/bin/tar', '-xJf', archive, '--strip-components', '1', '-C', ffmpeg)
            run(*prefix, '/bin/sh', ffmpeg/'configure', *flags, cwd=ffmpeg)
            run(*prefix, '/usr/bin/make', '-j8', cwd=ffmpeg)
            flags_file.write_text(json.dumps(flags))

        platform = 'osx-arm64' if architecture == 'arm64' else 'osx-x64'
        digest = ('b7b9602b3ea0d8724b2a4dd1370c97f2f1f7175f901e7088dad714352c4926d9' if architecture == 'arm64'
                  else '6211374e1fca1f0b0bb4bfc6395e493c5969416e116a976f87bac4bdb99320fd')
        sockseek = UPSTREAM/f'sockseek-3.0.6-{platform}.tar.gz'
        fetch(f'https://github.com/fiso64/sockseek/releases/download/v3.0.6/sockseek_3.0.6_{platform}.tar.gz', sockseek, digest)
        sockseek_files = UPSTREAM/f'sockseek-3.0.6-{platform}'
        sockseek_files.mkdir(exist_ok=True)
        run('/usr/bin/tar', '-xzf', sockseek, '-C', sockseek_files)
        for name, origin in [('sockseek', next(sockseek_files.rglob('sockseek'))),
                             ('ffmpeg', ffmpeg/'ffmpeg'), ('ffprobe', ffmpeg/'ffprobe')]:
            shutil.copy2(origin, destination/name)
            (destination/name).chmod(0o755)
        run(*prefix, python, ROOT/'scripts/package_licenses.py', resources/'Licenses'/architecture,
            work/'listd-backend/PYZ-00.toc')
        (resources/f'ffmpeg-build-{architecture}.json').write_text(json.dumps(flags, indent=2)+'\n')
    (resources/'tracklists').mkdir()
    shutil.copy2(ROOT/'tracklists/YouTube set bNSesW8h94I.csv', resources/'tracklists')
    sources = resources/'Sources'
    sources.mkdir()
    # Explicit allowlist: never package the workspace, downloads, account or saved jobs.
    for name in ('crate_backend.py', 'music_sorter.py', 'build-crate', 'package-crate',
                 'requirements-crate.txt', 'requirements-package.txt', 'SHARING.md'):
        shutil.copy2(ROOT/name, sources/name)
    shutil.copytree(ROOT/'native', sources/'native', ignore=shutil.ignore_patterns('.DS_Store'))
    shutil.copytree(ROOT/'scripts', sources/'scripts', ignore=shutil.ignore_patterns('__pycache__'))
    shutil.copy2(archive, sources/archive.name)
    shutil.copy2(source, sources/source.name)
    shutil.copy2(ROOT/'THIRD_PARTY.md', resources/'THIRD_PARTY.md')
    run('/usr/bin/python3', ROOT/'scripts/check_package.py', app)

    identity = os.environ.get('LISTD_SIGN_IDENTITY', '-')
    profile = os.environ.get('LISTD_NOTARY_PROFILE')
    if profile and identity == '-':
        raise ValueError('Notarization requires LISTD_SIGN_IDENTITY for a Developer ID certificate.')
    run('/usr/bin/xattr', '-cr', app)
    signing = ['--options', 'runtime', '--timestamp', '--entitlements', ROOT/'native/Backend.entitlements'] if identity != '-' else []
    if identity != '-':
        for path in backend.rglob('*'):
            if not path.is_file() or path.is_symlink():
                continue
            with path.open('rb') as file:
                magic = file.read(4)
            if magic in (b'\xcf\xfa\xed\xfe', b'\xce\xfa\xed\xfe', b'\xca\xfe\xba\xbe', b'\xbe\xba\xfe\xca'):
                run('/usr/bin/codesign', '--force', '--sign', identity, *signing, path)
    run('/usr/bin/codesign', '--force', '--deep', '--sign', identity, *signing, app)
    run('/usr/bin/codesign', '--verify', '--deep', '--strict', app)
    zip_path = staging/'LiSTd-Mac.zip'
    run('/usr/bin/ditto', '-c', '-k', '--sequesterRsrc', '--keepParent', payload, zip_path)
    if profile:
        result = subprocess.check_output(['/usr/bin/xcrun', 'notarytool', 'submit', str(zip_path),
                                          '--keychain-profile', profile, '--wait', '--output-format', 'json'], text=True)
        if json.loads(result).get('status') != 'Accepted':
            raise ValueError('Apple did not accept notarization. Inspect the notarytool submission log.')
        run('/usr/bin/xcrun', 'stapler', 'staple', app)
        zip_path.unlink()
        run('/usr/bin/ditto', '-c', '-k', '--sequesterRsrc', '--keepParent', payload, zip_path)
    shutil.copy2(zip_path, release/zip_path.name)
    print(f'Ready to share: {release/zip_path.name}')
    if identity == '-':
        print('Ad-hoc signed: recipients must approve opening in macOS Privacy & Security. See SHARING.md.')


if __name__ == '__main__':
    main()
